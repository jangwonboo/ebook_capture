{
  // 책 정보 config (리더 knobs는 reader_profiles.jsonc / --reader 로).
  // 우선순위: CLI 플래그 > reader 프로필 > 이 파일.

  // 책 폴더명 (출력: {base_dir}/{title}/)
  "title": "세컨드 브레인은 옵시디언",
  // 캡처할 페이지 수
  "n_pages": 360,
  // 첫 페이지 번호 (파일명 _0001 등에 사용)
  "start_page": 1,
  // 출력 상위 폴더 (절대 경로)
  "base_dir": "E:\\ebook",

  // 출력: images | pdf | text
  "output_mode": "pdf",

  // 리더 프로필 이름만 지정 (동작은 reader_profiles.jsonc).
  // kindle_app | kindle_cloud | aladin_app | aladin_web | "" (미사용)
  "reader_profile": "aladin_app",

  // true: 중단 후 같은 명령으로 이어서 캡처
  "resume": true,
  // 강제 재실행: "" | capture | ocr | pdf | all
  "force_phase": "",

  // OCR 언어 힌트 (text 모드)
  "ocr_lang": "kor",
  // Gemini OCR 프롬프트 (비우면 assets/ocr_default_prompt.txt)
  "ocr_text_prompt": "",
  "ocr_prompt_file": "",

  // Markdown 조립: full | prose | raw
  "assemble_style": "full"
}
