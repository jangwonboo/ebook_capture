{
  // 책 폴더명 (출력: {base_dir}/{title}/)
  "title": "the_meaning_of_your_life",
  // 캡처할 페이지 수
  "n_pages": 292,
  // 첫 페이지 번호 (파일명 _0001 등에 사용)
  "start_page": 1,
  // 출력 상위 폴더 (절대 경로)
  "base_dir": "E:\\ebook",

  // 출력: images | pdf | text
  "output_mode": "pdf",

  // 리더 프로필 (reader_profiles.jsonc): kindle_app | kindle_cloud |
  //   aladin_app | aladin_web | "" (미사용). 지정 시 해당 리더 동작을 적용.
  // 개별 필드(next_key 등)나 CLI 플래그가 프로필보다 우선.
  "reader_profile": "kindle_app",

  // 캡처 영역:
  //   manual — rect 좌표 직접 지정
  //   window_full | window_left_third | window_right_third — 대상 창 기준
  //   screen_left_third — 창을 화면 왼쪽 1/3·전체 높이로 맞춘 뒤 client 영역 캡처
  "capture_mode": "screen_left_third",
  // 대상 창 제목 (부분 일치, 대소문자 무시). GUI Refresh windows 참고
  "target_window_title": "Kindle",
  // true: 창 안쪽(client)만 캡처 / false: 타이틀바 포함 frame
  "use_window_client_rect": true,
  // 여러 창이 맞을 때 포그라운드 창 우선
  "prefer_foreground_window_match": true,
  // printwindow — HWND 비트맵 / screen — 화면 영역(mss). screen_left_third 는 screen 권장
  "window_capture_backend": "screen",
  // 캡처 순간 커서를 영역 밖으로 잠깐 이동
  "hide_cursor_during_capture": true,

  // manual 모드일 때만 사용 (left, top, width, height)
  "rect": { "left": 0, "top": 0, "width": 0, "height": 0 },

  // 페이지 넘긴 뒤 대기(초)
  "delay_sec": 2.0,
  // 다음 페이지 키: pagedown | pageup | right | left | down | up | space | enter
  // Kindle Cloud Reader(read.amazon.com): right 권장 (pagedown도 가능)
  "next_key": "right",
  // 키 전달 방식:
  //   auto — 앱에 맞게 자동 (Chrome→PostMessage, 네이티브→SendInput 등)
  //   sendinput | postmessage | postmessage_top | pyautogui
  // Kindle(브라우저): sendinput 또는 pyautogui 권장
  "key_delivery": "sendinput",
  // 각 페이지를 "캡처하기 전에" 본문을 클릭해 리더 포커스 확보 (0=클릭 없음).
  // 클릭 간격은 시스템 더블클릭 시간보다 넓게 자동 조정됨.
  "reader_focus_clicks": 2,
  // 클릭 위치 (캡처 영역 비율). 중앙이 안전 — 상단은 툴바, 좌우는 페이지 이동 영역.
  "reader_focus_x_ratio": 0.5,
  "reader_focus_y_ratio": 0.5,
  // 클릭 후 페이지 화살표/툴바가 사라질 때까지 대기(초)
  "focus_click_settle_sec": 1.0,

  // 시작 시 창 resize / 포커스 (기본 끔 — 리더를 미리 배치)
  "fit_on_start": false,
  "start_focus_clicks": 0,
  "start_focus_x_ratio": 0.5,
  "start_focus_y_ratio": 0.5,
  // PDF 생성 시 상하좌우 마진 crop (캡처 폭/높이 비율, 0.0–0.45)
  "pdf_trim": { "left": 0.0, "right": 0.0, "top": 0.0, "bottom": 0.0 },

  // true: 중단 후 같은 명령으로 이어서 캡처
  "resume": true,
  // 강제 재실행: "" | capture | ocr | pdf | all
  "force_phase": "",

  // OCR 언어 힌트 (text 모드)
  "ocr_lang": "kor",
  // Gemini OCR 프롬프트 (비우면 assets/ocr_default_prompt.txt)
  "ocr_text_prompt": "",
  "ocr_prompt_file": "",

  // Markdown 조립: full | prose | raw
  "assemble_style": "full"
}
